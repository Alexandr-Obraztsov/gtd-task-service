NODE_ENV=development
PORT=3000
TRUST_PROXY=0

POSTGRES_USER=gtd
POSTGRES_PASSWORD=gtd_dev_password
POSTGRES_DB=gtd
POSTGRES_PORT=5432
DATABASE_URL=postgres://gtd:gtd_dev_password@127.0.0.1:5432/gtd

JWT_SECRET=replace-with-64-random-hex-chars-for-access-tokens-0000000000
JWT_REFRESH_SECRET=replace-with-another-64-random-hex-chars-for-refresh-000000
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=7
BCRYPT_ROUNDS=12

CORS_ORIGINS=http://localhost:5173,http://localhost:3000
BODY_LIMIT=10kb

RATE_LIMIT_WINDOW_MINUTES=15
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=20
LOCKOUT_MAX_ATTEMPTS=5
LOCKOUT_DURATION_MINUTES=15

LOG_DIR=logs
LOG_LEVEL=info

SEED_ADMIN_EMAIL=admin@gtd.local
SEED_ADMIN_PASSWORD="Admin#Pass123"
SEED_MODERATOR_EMAIL=moderator@gtd.local
SEED_MODERATOR_PASSWORD="Moder#Pass123"
SEED_USER_EMAIL=user@gtd.local
SEED_USER_PASSWORD="User#Pass123"
