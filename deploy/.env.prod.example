# Окружение docker-compose.prod.yml. Скопировать в ../.env на сервере (chmod 600).
# Секреты генерируются командой: openssl rand -hex 32
APP_DOMAIN=gtd.cloudyyy.tech

POSTGRES_USER=gtd
POSTGRES_PASSWORD=
POSTGRES_DB=gtd

JWT_SECRET=
JWT_REFRESH_SECRET=
# Токен доступа к /metrics и /dashboard (не короче 32 символов)
METRICS_TOKEN=

# Учётные записи, создаваемые scripts/seed.js
SEED_ADMIN_EMAIL=admin@gtd.cloudyyy.tech
SEED_ADMIN_PASSWORD=
SEED_MODERATOR_EMAIL=moderator@gtd.cloudyyy.tech
SEED_MODERATOR_PASSWORD=
SEED_USER_EMAIL=user@gtd.cloudyyy.tech
SEED_USER_PASSWORD=

# GlitchTip (совместим с Sentry): секрет Django и DSN проектов backend / frontend
GLITCHTIP_SECRET_KEY=
SENTRY_DSN=
VITE_SENTRY_DSN=

# Пароль администратора Grafana
GRAFANA_ADMIN_PASSWORD=
